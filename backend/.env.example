# Environment Configuration for RecoverX

# Environment
ENV=development

# Database (Default: local SQLite database file, zero config)
# DATABASE_URL=sqlite:///recoverx.db

# JWT Security
JWT_SECRET=recoverx-super-secret-jwt-key-2026

# Razorpay Test Mode Credentials
RAZORPAY_KEY_ID=rzp_test_recoverxDemoKey123
RAZORPAY_KEY_SECRET=recoverxSecretKeyDemoTestMode999
RAZORPAY_WEBHOOK_SECRET=webhook_secret_demo_987654321

# Google Gemini AI (Optional - system falls back to 100% deterministic regex if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
